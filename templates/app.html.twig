<!doctype html><html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>Mon Atelier de Classe</title><link rel="stylesheet" href="{{ asset('app.css') }}"></head><body data-csrf="{{ csrf }}" data-base="{{ app.request.baseUrl }}">
<aside><div class="brand"><span>MA</span><div><b>Mon Atelier</b><small>de Classe</small></div></div><nav>{% for id,label in {'dashboard':'Tableau de bord','referential':'Référentiel','programming':'Programmation','journal':'Cahier journal','preps':'Fiches de prépa','sequences':'Séquences','settings':'Paramètres'} %}<button data-view="{{ id }}">{{ label }}</button>{% endfor %}</nav><div class="account"><b>{{ user.name }}</b><span>{{ user.email }}</span><a href="{{ path('logout') }}">Se déconnecter</a></div></aside>
<main><header><div><p class="eyebrow">Année 2026–2027 · Mayotte</p><h1 id="pageTitle">Tableau de bord</h1></div><div><a class="button ghost" href="{{ path('backup') }}">Sauvegarder</a><button class="button" onclick="window.print()">Imprimer / PDF</button></div></header>
<section id="dashboard" class="view"><div class="hero"><div><span>Prêt pour la classe</span><h2>De la compétence à la séance,<br>sans repartir d’une page blanche.</h2><p>Vos objectifs, préparations, séquences et journées sont désormais enregistrés dans votre base personnelle.</p></div><strong>{{ stats.competencies }}</strong></div><div class="stats"><article><b>{{ stats.competencies }}</b><span>objectifs</span></article><article><b>{{ stats.preps }}</b><span>fiches de prépa</span></article><article><b>{{ stats.sequences }}</b><span>séquences</span></article><article><b>{{ stats.journal }}</b><span>séances planifiées</span></article></div><h2>Calendrier de Mayotte</h2><div class="periods"><article><b>P1</b><span>24 août → 10 octobre</span></article><article><b>P2</b><span>26 octobre → 12 décembre</span></article><article><b>P3</b><span>11 janvier → 20 février</span></article><article><b>P4</b><span>8 mars → 30 avril</span></article><article><b>P5</b><span>18 mai → 10 juillet</span></article></div></section>
<section id="referential" class="view hidden"><div class="toolbar"><input id="refSearch" placeholder="Rechercher une compétence ou un objectif…"><select id="refSubject"><option value="">Toutes les matières</option></select><select id="refPeriod"><option value="">Toutes périodes</option><option>P1</option><option>P2</option><option>P3</option><option>P4</option><option>P5</option></select></div><p id="refCount"></p><div id="refList" class="grid"></div></section>
<section id="programming" class="view hidden"><div id="programmingList" class="programming"></div></section>
<section id="journal" class="view hidden"><div class="split"><form id="journalForm" class="panel"><h2>Ajouter ou modifier une séance</h2><input type="hidden" name="id"><div class="row3"><label>Date<input type="date" name="entry_date" required></label><label>Début<input type="time" name="start_time" required></label><label>Fin<input type="time" name="end_time" required></label></div><label>Fiche de préparation<select name="prep_id"><option value="">Aucune fiche liée</option></select></label><label>Compétence<select name="competency_id" required></select></label><label>Titre<input name="title" required></label><label>Objectif modifiable<textarea name="objective" required></textarea></label><label>Activité / déroulement<textarea name="activity"></textarea></label><label>Matériel<input name="materials"></label><label>Différenciation<textarea name="differentiation"></textarea></label><label>Évaluation<textarea name="assessment"></textarea></label><button class="primary">Enregistrer la séance</button></form><div><div class="toolbar"><input type="date" id="journalDate"><button class="button" id="duplicateDay">Dupliquer la journée</button></div><div id="journalList"></div></div></div></section>
<section id="preps" class="view hidden"><div class="split"><form id="prepForm" class="panel"><h2>Fiche de préparation</h2><input type="hidden" name="id"><label>Nom de la fiche<input name="name" required></label><label>Compétence<select name="competency_id" required></select></label><label>Objectif modifiable<textarea name="objective" required></textarea></label><label>Durée<input name="duration" value="45 min"></label><label>Matériel<textarea name="materials"></textarea></label><label>Déroulement<textarea name="steps" rows="8">1. Mise en situation
2. Recherche / manipulation
3. Mise en commun
4. Institutionnalisation
5. Entraînement</textarea></label><label>Différenciation<textarea name="differentiation"></textarea></label><label>Évaluation<textarea name="assessment"></textarea></label><button class="primary">Enregistrer la fiche</button></form><div id="prepList"></div></div></section>
<section id="sequences" class="view hidden"><div class="split"><form id="sequenceForm" class="panel"><h2>Créer une séquence</h2><input type="hidden" name="id"><label>Nom<input name="name" required></label><label>Matière<input name="subject" required></label><label>Période<select name="period"><option>P1</option><option>P2</option><option>P3</option><option>P4</option><option>P5</option></select></label><label>Description<textarea name="description"></textarea></label><label>Compétences (identifiants séparés par des virgules)<input name="competency_ids"></label><label>Plan des séances<textarea name="session_plan" rows="9">Séance 1 — Découverte
Séance 2 — Recherche
Séance 3 — Structuration
Séance 4 — Entraînement
Séance 5 — Évaluation</textarea></label><label>Évaluation<textarea name="assessment"></textarea></label><button class="primary">Enregistrer la séquence</button></form><div id="sequenceList"></div></div></section>
<section id="settings" class="view hidden"><div class="split"><form id="settingsForm" class="panel"><h2>Paramètres de la classe</h2><input type="hidden" name="id"><label>École<input name="school"></label><label>Enseignant<input name="teacher" value="{{ user.name }}"></label><label>Classe<input name="class_name" value="CM1"></label><label>Effectif<input type="number" name="student_count"></label><label>Année scolaire<input name="school_year" value="2026-2027"></label><label>Localité<input name="location" value="Mayotte"></label><div class="row3"><label>Début<input type="time" name="day_start"></label><label>Fin<input type="time" name="day_end"></label></div><label>Jours travaillés<input name="week_days" value="Lundi,Mardi,Mercredi,Jeudi,Vendredi"></label><label>Récréations<input name="breaks" placeholder="09:45-10:00, 14:30-14:45"></label><button class="primary">Enregistrer</button></form><form method="post" action="{{ path('account') }}" class="panel"><h2>Compte enseignant</h2><input type="hidden" name="_token" value="{{ csrf }}"><label>Nom<input name="name" value="{{ user.name }}"></label><label>Nouveau mot de passe<input type="password" name="password" minlength="10" placeholder="10 caractères minimum"></label><button class="primary">Modifier le compte</button><hr><h3>Préparer Infomaniak</h3><p>La configuration locale est séparée des identifiants de production. Le paquet de déploiement sera généré après validation fonctionnelle.</p></form></div></section>
</main><div id="toast"></div><script src="{{ asset('app.js') }}"></script></body></html>
